{
  "name": "fc-online-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:mock": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-playground.ts && tsx prisma/import-official.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:import:official": "tsx prisma/import-official.ts",
    "data:validate": "tsx prisma/import-official.ts --validate-only",
    "data:players": "tsx src/jobs/player-metadata.ts",
    "data:prices": "tsx src/jobs/player-prices.ts",
    "data:resolution": "tsx src/jobs/reward-resolution.ts",
    "prices:plan": "tsx src/jobs/price-collection.ts plan",
    "prices:collect": "tsx src/jobs/price-collection.ts collect",
    "prices:status": "tsx src/jobs/price-collection.ts status",
    "prices:plan:full": "tsx src/jobs/full-market.ts plan",
    "prices:collect:full": "tsx src/jobs/full-market.ts collect",
    "prices:status:full": "tsx src/jobs/full-market.ts status",
    "prices:plan:incremental": "tsx src/jobs/incremental-prices.ts plan",
    "prices:collect:incremental": "tsx src/jobs/incremental-prices.ts collect",
    "prices:collect:reference": "tsx src/jobs/price-collection.ts collect --window-only",
    "prices:control": "tsx src/jobs/collection-control.ts",
    "prices:cost": "tsx src/jobs/collection-cost.ts",
    "prices:sync": "tsx src/jobs/price-sync.ts sync",
    "prices:bootstrap": "tsx src/jobs/price-sync.ts bootstrap",
    "prices:reconcile": "tsx src/jobs/price-sync.ts reconcile",
    "prices:sync:status": "tsx src/jobs/price-sync.ts status",
    "prices:reference": "tsx src/jobs/reference-snapshots.ts",
    "prices:infrastructure": "tsx src/jobs/price-infrastructure.ts",
    "prices:observe": "tsx src/jobs/price-observation.ts",
    "prices:worker": "tsx src/jobs/price-worker.ts",
    "prices:full": "tsx src/jobs/legacy-prices.ts full",
    "prices:hot": "tsx src/jobs/legacy-prices.ts hot",
    "prices:benchmark": "tsx src/jobs/price-benchmark.ts",
    "prices:full:run": "tsx src/jobs/full-coordinator.ts",
    "prices:full:audit": "tsx src/jobs/full-market-audit.ts",
    "prices:full:supervise": "python3 scripts/full-market-supervisor.py"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cheerio": "1.1.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.6.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "esbuild": "0.28.1"
  },
  "type": "module"
}

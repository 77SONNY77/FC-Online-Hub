# Local-only example. Use a unique password outside your own development machine.
DATABASE_URL="postgresql://fco:fco_local_dev@127.0.0.1:55432/fco?schema=public"
# Reserved; not used in Phase 3. Never prefix with NEXT_PUBLIC_.
NEXON_API_KEY=

# Set the exact public origin behind an HTTPS reverse proxy; omit locally.
# APP_ORIGIN="https://your-domain.example"

# Internal conservative operating limits, NOT an officially confirmed safe rate.
# A rolling budget counts policy GET + price POST + retries across all CLI processes.
PRICE_COLLECTION_ENABLED=true
PRICE_COLLECTION_MAX_CONCURRENCY=1
PRICE_COLLECTION_REQUEST_DELAY_MS=10000
PRICE_COLLECTION_MAX_REQUESTS_PER_MINUTE=6
PRICE_COLLECTION_MAX_REQUESTS_PER_HOUR=60
PRICE_COLLECTION_MAX_REQUESTS_PER_DAY=120
# Per CLI execution/resume, not lifetime of the full-build manifest.
PRICE_COLLECTION_MAX_REQUESTS_PER_RUN=20
PRICE_COLLECTION_CIRCUIT_BREAKER_THRESHOLD=3
PRICE_COLLECTION_CIRCUIT_COOLDOWN_HOURS=24
# Minimum source interval is not a mandate to refresh everything every two hours.
PRICE_COLLECTION_HOT_HOURS=6
PRICE_COLLECTION_WARM_HOURS=48
PRICE_COLLECTION_COLD_HOURS=336
PRICE_COLLECTION_WARM_CLASS_LIMIT=2
# Displayed observation freshness, distinct from verified reference-time freshness.
PRICE_FRESH_HOURS=24

# Phase 4.6C: scheduler tick is eligibility checking, not source polling.
PRICE_SYNC_INTERVAL_MINUTES=30
# 120-day reconciliation is an operator policy, not an official market cadence.
PRICE_FULL_RECONCILIATION_DAYS=120
PRICE_HISTORY_HEARTBEAT_HOURS=24
PRICE_SYNC_VERY_STALE_HOURS=720
# Captures observations only; does not certify a pack reference timestamp.
PRICE_SYNC_REFERENCE_ENABLED=false
PRICE_SYNC_REFERENCE_PACK=official-pool-24987-v1

# Phase 4.7P: provisional policy, NOT a Nexon safe rate or exact source clock.
PRICE_MIN_REFRESH_INTERVAL_HOURS=2
# Fairness among productive non-reference batches; insufficient total budget can still violate freshness.
PRICE_MAX_CONSECUTIVE_BOOTSTRAP_BATCHES=2
PRICE_MAX_CONSECUTIVE_REFRESH_BATCHES=2
PRICE_OBSERVATION_LARGE_CHANGE_PERCENT=10
PRICE_OBSERVATION_WINDOW_TOLERANCE_MINUTES=15

# Phase 4.7R: worker pool supports 1–6. Keep SAFE_DEFAULT=1 until throughput policy is validated.
# Legacy observed 6 workers / 600ms per worker is historical evidence, NOT a safe rate.
# Request delay above is GLOBAL start spacing, including concurrent slots and retries.
# Client timeout in milliseconds (bounded request timeout, not whole-run timeout).
REQUEST_TIMEOUT_MS=30000

# Phase 4.7S explicit FULL execution profile, not a Nexon-approved rate.
# Bounded 5s validation succeeded; defaults above stay conservative for other jobs.
# Supply together to prices:full:run (do not copy legacy 6 workers / 0.6s blindly):
# PRICE_COLLECTION_MAX_CONCURRENCY=2
# PRICE_COLLECTION_REQUEST_DELAY_MS=5000
# PRICE_COLLECTION_MAX_REQUESTS_PER_MINUTE=12
# PRICE_COLLECTION_MAX_REQUESTS_PER_HOUR=720
# PRICE_COLLECTION_MAX_REQUESTS_PER_DAY=5000
# PRICE_COLLECTION_MAX_REQUESTS_PER_RUN=51
# Coordinator --batch-size 50 --batches 100; every batch checks persisted safety.
# Hour/day budget exhaustion pauses; resume same run after cooldown, never a new run.
# PRICE_FULL_STOP_AT is an optional ISO timestamp supplied per coordinator execution.
# It is checked immediately before source requests, including after machine sleep.
# The execution supervisor sets it to avoid the existing independent legacy cron.
